# Copy to .env and fill in. Never commit the filled file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one guild while developing.
DISCORD_DEV_GUILD_ID=
DATABASE_URL=postgres://bot:bot@localhost:5432/bot
# Optional: without Redis the bot falls back to an in-process cache (single process only).
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# "auto" queries GET /gateway/bot; a number forces a shard count.
SHARD_COUNT=auto
# Register slash commands on boot (dev convenience; prefer `npm run deploy` in production).
REGISTER_COMMANDS_ON_BOOT=false
