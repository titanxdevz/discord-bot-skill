{
  "name": "discord-bot-example",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Reference discord.js v14.28 bot: commands, router, modals, Components V2, Postgres, Redis, sharding, graceful shutdown.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "shard": "node dist/src/shard.js",
    "deploy": "node dist/src/deploy-commands.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
